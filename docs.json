      {
        "tab": "CLI",
        "groups": [
          { "group": "The released CLI", "pages": ["cli/overview", "cli/install", "cli/setup", "cli/workspaces", "cli/connect", "cli/tools-and-mcp", "cli/observe-claude-code"] }
        ]
      },
      {
